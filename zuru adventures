    <style>
        /* Basic Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            line-height: 1.6;
            color: #333;
            background-color: #f5f5f5;
        }

        /* Header Styles */
        header {
            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('zebra.jpg');
            background-size: cover;
            background-position: center;
            color: white;
            text-align: center;
            padding: 100px 20px;
        }

        .logo {
            width: 200px;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 20px;
        }

        .tagline {
            font-size: 1.2rem;
            margin-bottom: 30px;
        }

        /* Navigation */
        nav {
            background-color:#355b24;
            padding: 15px 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        nav ul {
            display: flex;
            justify-content: center;
            list-style: none;
        }

        nav ul li {
            margin: 0 15px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            font-weight: bold;
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #f39c12;
        }

        /* Main Content */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        section {
            padding: 50px 0;
        }

        h2 {
            text-align: center;
            margin-bottom: 40px;
            color: #2c3e50;
            font-size: 2rem;
        }

        /* Tours Section */
        .tours {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
        }

        .tour-card {
            width: 30%;
            margin-bottom: 30px;
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s;
        }

        .tour-card:hover {
            transform: translateY(-10px);
        }

        .tour-img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .tour-info {
            padding: 20px;
        }

        .tour-info h3 {
            margin-bottom: 10px;
            color: #2c3e50;
        }

        .tour-info p {
            margin-bottom: 15px;
            color: #7f8c8d;
        }

        .price {
            font-weight: bold;
            color: #e74c3c;
            font-size: 1.2rem;
        }

        .btn {
            display: inline-block;
            background: #f39c12;
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            text-decoration: none;
            margin-top: 10px;
            transition: background 0.3s;
        }

        .btn:hover {
            background: #e67e22;
        }

        /* About Section */
        .about-content {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .about-img {
            width: 50%;
            border-radius: 8px;
        }

        .about-text {
            width: 50%;
        }

        /* testimonial */
        .testimonial {
            background-color: #ecf0f1;
            padding: 50px 0;
        }

        .testimonial-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
        }

        .testimonial {
            width: 30%;
            background: white;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        .testimonial img {
            width: 50px;
            height: 50px;
            border-radius: 30%;
            object-fit: fill;
            margin-right: 15px;
            float: left;
        }

        .testimonial-text {
            overflow: hidden;
        }

        .testimonial-text p {
            font-style: italic;
            margin-bottom: 10px;
        }

        .testimonial-text .name {
            font-weight: bold;
            color: #2c3e50;
        }

        /* Contact Section */
        .contact-form {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        .form-group textarea {
            height: 150px;
        }

        /* Footer */
        footer {
            background-color: #2c3e50;
            color: white;
            text-align: center;
            padding: 30px 0;
        }

        .social-links {
            margin: 20px 0;
        }

        .social-links a {
            color: white;
            margin: 0 10px;
            font-size: 1.5rem;
            transition: color 0.3s;
        }

        .social-links a:hover {
            color: #f39c12;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .tour-card, .testimonial {
                width: 48%;
            }

            .about-content {
                flex-direction: column;
            }

            .about-img, .about-text {
                width: 100%;
            }
        }

        @media (max-width: 480px) {
            .tour-card, .testimonial {
                width: 100%;
            }

            nav ul {
                flex-direction: column;
                align-items: center;
            }

            nav ul li {
                margin: 5px 0;
            }
        }

         /* Merch and Other Services Styles */
        #merch-services h2 {
            /* Inherits from the general h2 style */
        }

        #merch-services > div { /* Style the container div */
            margin-bottom: 30px;
            text-align: center;
        }

        #merch-services h3 {
            margin-top: 50px;
            /* You can add more specific styling if needed */
        }

        .merch-services-container {
            display: flex;
            gap: 40px;
            padding: 0 20px;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
        }

        .merch-slide {
